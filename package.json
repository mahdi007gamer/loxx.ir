{
  "name": "loxx-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/run-studio.mjs dev",
    "start": "node tools/run-studio.mjs start",
    "setup:local": "node tools/setup-local.mjs",
    "build": "npm run build -w @loxx/api && npm run build -w @loxx/web",
    "typecheck": "npm run typecheck -w @loxx/api && npm run typecheck -w @loxx/web",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
